# Copie para ".env" e ajuste. O .env fica fora do git.
# Estes valores valem para os DOIS caminhos: start.ps1 e docker compose.

# Heap da JVM. Numa VPS, use no maximo ~70% da RAM da maquina.
MEMORY=6G

# Teto de RAM do container (so no Docker). Precisa ser maior que MEMORY,
# porque a JVM gasta alem do heap: metaspace, threads, buffers off-heap.
MEMORY_LIMIT=8G

# Porta exposta no host (so no Docker). 25565 e a padrao do Minecraft.
SERVER_PORT=25565

# Coloque "true" depois de ler https://aka.ms/MinecraftEULA
# O servidor se recusa a iniciar enquanto isso for false, nos dois caminhos.
EULA=false
