# Forca LF em tudo que roda dentro do container.
# Sem isso, um clone no Windows converte para CRLF e o entrypoint
# morre com "bad interpreter: /usr/bin/env bash^M".
* text=auto eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
Dockerfile   text eol=lf

# O .bat e a excecao a regra acima: ele roda no cmd.exe, nao no container.
# Com LF o interpretador tropeca em label e goto, entao aqui vale CRLF.
*.bat  text eol=crlf

*.jar binary
*.zip binary
*.tar.gz binary
